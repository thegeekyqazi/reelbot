# ---- Required ----------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here
# Your own Discord user ID (Settings -> Advanced -> Developer Mode, then right-click yourself -> Copy User ID).
# Always allowed, and the only user who can run /allow, /disallow, /allowlist.
OWNER_ID=123456789012345678

# ---- Optional ----------------------------------------------------------
# Comma-separated user IDs to seed the allowlist on first run (ignored once data/allowlist.json exists).
ALLOWED_USER_IDS=
# true = anyone who installs the app can use it (disables the allowlist).
ALLOW_EVERYONE=false
# Path to a Netscape-format Instagram cookies.txt (use a throwaway account).
# Authenticated retries always require IG_PROXY; public downloads stay anonymous.
IG_COOKIES=
# Private account file for login-required posts. Format: username:password[:TOTP-secret]
# Also accepts username:password:email:email-password:TOTP-secret (mail fields are unused).
# Store under DATA_DIR with mode 600, never in Git. Sessions are cached under DATA_DIR/ig-sessions.
IG_ACCOUNTS=
# Proxies used for anonymous rate-limit retries and ALL authenticated logins/downloads,
# tried one after another. Comma-separated URLs (http://user:pass@host:port, socks5h://host:1080)
# or Webshare's host:port:user:pass format.
IG_PROXY=
# Upload limit in MB. Discord's default for apps is 10.
MAX_UPLOAD_MB=10
# Domain used for the fallback embed link when a download fails.
EMBED_FIXER_DOMAIN=instagramfix.com
# Where allowlist.json lives. Must be writable by the bot.
DATA_DIR=./data
# Parallel downloads. Keep low on small VMs (e2-micro has 1 GB RAM).
MAX_CONCURRENT_DOWNLOADS=2
